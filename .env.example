# Copy to .env for local development. Never commit .env.

# BigQuery
BQ_PROJECT_ID=chicago-transit-513422
# BQ_DATASET=transit_data
# Path to a service-account key (local only; on Cloud Run the job's service account is used)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# API credentials (on Cloud Run these come from CHICAGO_TRANSIT_SECRET_JSON instead)
CHICAGO_APP_TOKEN=
CHICAGO_SECRET_TOKEN=
CTA_TRAIN_API_KEY=
CTA_BUS_API_KEY=
METRA_API_TOKEN=

# ETL: "bq" (default) uploads to BigQuery, "df" just prints the frames
# OUTPUT_MODE=bq

# Web app: how often the browser polls the API (ms)
# REFRESH_MS=60000
